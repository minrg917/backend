# 이 파일을 복사해 .env 로 만든 뒤 값을 채운다.
#   cp .env.example .env
# .env 는 절대 커밋하지 않는다.

# ---- 애플리케이션 ----
APP_NAME=사릴스(SARILS) API
DEBUG=true

# ---- 데이터베이스 (docker-compose.yml 기본값과 동일) ----
DB_HOST=localhost
# 로컬 3306이 이미 사용 중이면 3307 등으로 바꾼다.
# docker-compose 의 호스트 포트도 이 값을 따라간다.
DB_PORT=3306
DB_USER=sarils
DB_PASSWORD=sarils
DB_NAME=sarils

# ---- CORS (프론트 개발 서버 주소, 쉼표로 구분) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
