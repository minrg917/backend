# 이 파일을 복사해 .env 로 만든 뒤 값을 채운다.
#   cp .env.example .env
# .env 는 절대 커밋하지 않는다.

# ---- 애플리케이션 ----
APP_NAME=사릴스(SARILS) API
DEBUG=true

# ---- 데이터베이스 (docker-compose.yml 기본값과 동일) ----
DB_HOST=localhost
# 로컬 3306이 이미 사용 중이면 3307 등으로 바꾼다.
# docker-compose 의 호스트 포트도 이 값을 따라간다.
DB_PORT=3306
DB_USER=sarils
DB_PASSWORD=sarils
DB_NAME=sarils

# ---- CORS (프론트 개발 서버 주소, 쉼표로 구분) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- JWT (운영에서는 반드시 새로 생성한 값으로 바꾼다) ----
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-only-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
# 액세스 토큰 만료(분) — API명세서 1.3 expires_in(3600초) 기준
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 리프레시 토큰 만료(일)
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- 외부 장소 검색 API (2.1 가게 통합검색) ----
# 비워두면 해당 출처는 검색에서 제외된다(서버는 정상 기동).
# NAVER: https://developers.naver.com → 애플리케이션 등록 → 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Kakao: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=
# 외부 API 호출 타임아웃(초)
EXTERNAL_API_TIMEOUT_SECONDS=3.0
