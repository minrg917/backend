# 이 파일을 복사해 .env 로 만든 뒤 값을 채운다.
#   cp .env.example .env
# .env 는 절대 커밋하지 않는다.

# ---- 애플리케이션 ----
APP_NAME=사릴스(SARILS) API
DEBUG=true
# 로그 레벨: DEBUG / INFO / WARNING / ERROR (운영은 INFO)
LOG_LEVEL=INFO

# ---- 데이터베이스 (docker-compose.yml 기본값과 동일) ----
DB_HOST=localhost
# 로컬 3306이 이미 사용 중이면 3307 등으로 바꾼다.
# docker-compose 의 호스트 포트도 이 값을 따라간다.
DB_PORT=3306
DB_USER=sarils
DB_PASSWORD=sarils
DB_NAME=sarils

# ---- CORS (프론트 개발 서버 주소, 쉼표로 구분) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- JWT (운영에서는 반드시 새로 생성한 값으로 바꾼다) ----
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-only-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
# 액세스 토큰 만료(분) — API명세서 1.3 expires_in(3600초) 기준
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 리프레시 토큰 만료(일)
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- 외부 장소 검색 API (2.1 가게 통합검색) ----
# 비워두면 해당 출처는 검색에서 제외된다(서버는 정상 기동, 테스트도 통과).
#
# NAVER 지역검색은 2026-06-25 "NAVER API HUB"로 NCP에 이관됐고, 2026-07-31부로
# developers.naver.com 신규 발급이 종료됐다. 구방식(openapi.naver.com +
# X-Naver-Client-Id/Secret)은 2026-07-30 이전 발급 키만 2027-06-30까지 유효하다.
#   발급: https://ncloud.com 콘솔 → NAVER API HUB
#   엔드포인트는 API마다 경로가 달라 설정으로 받는다(지역검색은 /search/v1/local).
NAVER_SEARCH_LOCAL_URL=https://naverapihub.apigw.ntruss.com/search/v1/local
NAVER_API_KEY_ID=
NAVER_API_KEY=
# Kakao: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
# 키만 발급받으면 끝이 아니라 [제품 설정 › 카카오맵]을 활성화해야 한다(안 하면 403).
KAKAO_REST_API_KEY=
# 외부 API 호출 타임아웃(초)
EXTERNAL_API_TIMEOUT_SECONDS=3.0

# ---- AI 서버 (스펙 미확정) ----
# 비워두면 7.1 기획 생성이 임시 뼈대를 돌려준다(is_placeholder=true).
AI_SERVER_URL=
AI_SERVER_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_RENDERER_ALLOWED_HOSTS=
FFMPEG_PATH=ffmpeg

# ---- 촬영본 업로드 (9.2) ----
# 영상은 사진보다 훨씬 크므로 제한을 따로 둔다.
MAX_VIDEO_UPLOAD_SIZE_MB=200
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/x-m4v,video/webm

# ---- 파일 저장소 ----
# local = 서버 디스크(개발용) / s3 = AWS S3(운영)
STORAGE_BACKEND=local
# STORAGE_BACKEND=local 일 때만 쓰인다.
MEDIA_ROOT=media
MEDIA_URL_PATH=/media
# 응답에 나갈 URL 앞부분. 배포 시 실제 도메인으로 바꾼다.
MEDIA_BASE_URL=http://localhost:8000
# 업로드 제한(이미지)
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic

# ---- S3 (STORAGE_BACKEND=s3 일 때만) ----
# 액세스 키는 여기 넣지 않는다 — EC2에 IAM 역할을 붙이면 boto3가 알아서 찾는다.
S3_BUCKET=
S3_REGION=ap-northeast-2
# CloudFront나 커스텀 도메인을 쓸 때만 채운다.
S3_PUBLIC_BASE_URL=
# 0 = 공개 URL(버킷이 공개 읽기여야 함) / 3600 = 1시간짜리 서명 URL(버킷 비공개 가능)
S3_PRESIGN_EXPIRE_SECONDS=0

# ---- AWS 자격증명 (로컬 개발용) ----
# **EC2에서는 비워둔다.** 인스턴스에 IAM 역할(sarils-ec2-role)이 붙어 있어 boto3가
# 알아서 찾는다. 여기에 값을 넣으면 역할보다 우선 적용돼 권한이 꼬인다.
# 로컬에서 S3를 직접 테스트할 때만 채운다(IAM 사용자 액세스 키).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- SNS 연동 (R16) ----
# 연동은 Instagram / YouTube 두 곳만 지원한다.
# 게시는 NAVER Clip·TikTok도 되지만 성과 지표를 가져올 API가 없어 연동 대상이 아니다.
# 비워두면 해당 플랫폼 연동 시작이 503 SNS_NOT_CONFIGURED로 응답한다.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# OAuth 콜백을 받을 우리 서버 주소. 플랫폼 개발자 콘솔에 등록한 값과 **정확히** 같아야 한다.
# 예: https://api.sarils.com  (배포 도메인 확정 후 채운다)
SNS_REDIRECT_BASE_URL=
